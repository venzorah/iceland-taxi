# PostgreSQL (required for persistent data; APIs fall back to seed data when unset)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/iceland_taxi?schema=public"

# Public site URL (payments return URLs, absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps — features degrade clearly when unset
GOOGLE_MAPS_API_KEY=""

# Teya payments (https://teya.com/is) — checkout fails clearly when unset
TEYA_MERCHANT_ID=""
TEYA_API_KEY=""
TEYA_ENVIRONMENT="sandbox"
PAYMENT_PROVIDER="teya"

# Optional messaging / email
SMTP_URL=""
SMS_API_KEY=""
