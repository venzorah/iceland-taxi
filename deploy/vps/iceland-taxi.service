[Unit]
Description=Iceland Taxi Next.js application
After=network.target postgresql.service
Wants=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=iceland-taxi
Group=iceland-taxi
WorkingDirectory=/srv/iceland-taxi/current
EnvironmentFile=/etc/iceland-taxi/app.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=1024
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/iceland-taxi/current/.next/cache
RestrictSUIDSGID=true
MemoryAccounting=true
MemoryHigh=1536M
MemoryMax=2G
CPUWeight=200
TasksMax=256
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iceland-taxi
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
