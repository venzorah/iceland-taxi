# VPS templates and migration notes: deploy/vps/environment.example and docs/vps-deployment.md
# Standard PostgreSQL. URL-encode passwords; keep all real values private.
# One Next.js process, five runtime connections. Remote DBs must use TLS.
DATABASE_URL="postgresql://iceland_app:REPLACE_PASSWORD@127.0.0.1:5432/iceland_taxi?sslmode=disable&connection_limit=5&connect_timeout=10&pool_timeout=10&socket_timeout=20"
# Prisma requires DIRECT_URL. Use runtime credentials here; owner credentials belong
# in a separate migration environment when running prisma migrate deploy.
DIRECT_URL="postgresql://iceland_app:REPLACE_PASSWORD@127.0.0.1:5432/iceland_taxi?sslmode=disable"

# Public site URL (payment return URLs, absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps — Places autocomplete / geocode degrade clearly when unset
GOOGLE_MAPS_API_KEY=""

# -----------------------------------------------------------------------------
# Teya Online Payments — hosted checkout (card details stay on Teya).
# TEYA_ENVIRONMENT=production uses api.teya.com / id.teya.com.
# TEYA_ENVIRONMENT=sandbox uses api.teya.xyz / id.teya.xyz with separate test credentials.
# Production requires the registered webhook public key and HTTPS NEXT_PUBLIC_APP_URL.
# Docs: https://docs.teya.com/online-payments/hosted-checkout/get-started
# Never commit credentials. A live checkout can charge real money when completed.
# -----------------------------------------------------------------------------
TEYA_CLIENT_ID=""
TEYA_CLIENT_SECRET=""
TEYA_STORE_ID=""
TEYA_ENVIRONMENT="sandbox"
# PEM public key for the webhook you add in the same Integrations screen.
# Header x-teya-signature is SHA256withRSA (base64) over the raw body.
# Newlines in a single-line env value may be written as \n.
TEYA_WEBHOOK_PUBLIC_KEY=""
# Unused by the current verifier (Teya does not use an HMAC shared secret).
TEYA_WEBHOOK_SECRET=""
# Legacy aliases for client id / secret when the modern vars are empty.
TEYA_MERCHANT_ID=""
TEYA_API_KEY=""
PAYMENT_PROVIDER="teya"

# -----------------------------------------------------------------------------
# Web Push (optional). Sound + phone notifications work while the site is open
# without these. Set all three so a notification can arrive when the app is
# closed. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL you control. Do not invent one.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Optional messaging / email / SMS
# In-app chat uses Postgres + polling. Read state is stored on each message (unread until that side opens the thread).
# WhatsApp delivery uses CompanySettings.whatsappE164. The default is +3548353111.
# Other contact fields stay empty. Do not invent them.
# Without the Cloud API vars below, each customer message still creates a staff notification
# and a wa.me link (booking reference and a short notice only — not the private message).
# These vars send that same notice. They do not sync WhatsApp chats into the inbox.
# WHATSAPP_NOTIFY_E164 is optional. When empty, the notice is sent to the company number.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_NOTIFY_E164=""
WHATSAPP_API_VERSION="v21.0"
# SMTP connection string, for example smtp://user:password@smtp.example.com:587
# or smtps://user:password@smtp.example.com:465
# Bookings still save when this is empty. No email is sent, and the reason is stored.
SMTP_URL=""
# From address for those emails. Use an address your mail host is allowed to send as.
MAIL_FROM=""
# Protects GET /api/cron/reminders. Vercel Cron sends this as Authorization: Bearer.
# The job runs hourly. Admin edits the reminder times under System settings.
CRON_SECRET=""
SMS_API_KEY=""

# Database-backed authentication. Generate a private secret with at least 32 random bytes.
# Keep this identical across app restarts/instances; no NEXT_PUBLIC prefix.
BETTER_AUTH_SECRET=""
# Auth uses NEXT_PUBLIC_APP_URL as its sole canonical origin.
# The account importer uses separate private MIGRATION_SOURCE_URL and MIGRATION_TARGET_URL.
# These are operator-only and are not required by the running application.

# Independent server-only signing key for guest booking access cookies (at least 32 random bytes).
BOOKING_ACCESS_SECRET=""

# Server-side admin image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional trusted proxy IP header for public API rate limits. Leave empty unless the
# hosting proxy overwrites it and direct access to the origin is prevented.
# Allowed: x-real-ip or cf-connecting-ip. Empty uses a shared public budget.
RATE_LIMIT_PROXY_HEADER=""
