# PostgreSQL (required for live booking/admin/payments persistence)
# Runtime adds TLS, a 3-connection pool, and bounded connection/query/pool timeouts.
# Explicit connection URL parameters override those defaults.
DATABASE_URL="postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require"
# Optional: retain a transaction-pooler URL for a future serverless deployment (6543, pgbouncer=true).
DATABASE_TRANSACTION_URL=""
# Migration connection: Supabase session pooler (5432) or direct connection.
# URL-encode special characters in passwords. Never commit actual credentials.
DIRECT_URL="postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require"

# Public site URL (payment return URLs, absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps — Places autocomplete / geocode degrade clearly when unset
GOOGLE_MAPS_API_KEY=""

# -----------------------------------------------------------------------------
# Teya Online Payments — SANDBOX ONLY (https://teya.com/is · hosted checkout)
# Docs: https://developer.teya.com/online-payments/hosted-checkout/get-started
# Testing: https://developer.teya.com/online-payments/testing
# Never store card numbers. Customers pay on the Teya-hosted session_url.
# This app refuses TEYA_ENVIRONMENT=production and never calls api.teya.com.
#
# Teya does not publish a shared test merchant. Create a development store,
# then in https://business.teya.xyz → your store → Integrations create
# ecommerce API credentials. You get a Client ID, a Client Secret (shown
# once), and the Store ID. Paste those here or into the host's env. Do not
# commit the values.
#
# Frictionless sandbox card (any future expiry, any 3-digit CVC):
#   Visa 4427800000180034
# -----------------------------------------------------------------------------
TEYA_CLIENT_ID=""
TEYA_CLIENT_SECRET=""
TEYA_STORE_ID=""
TEYA_ENVIRONMENT="sandbox"
# PEM public key for the webhook you add in the same Integrations screen.
# Header x-teya-signature is SHA256withRSA (base64) over the raw body.
# Newlines in a single-line env value may be written as \n.
TEYA_WEBHOOK_PUBLIC_KEY=""
# Unused by the current verifier (Teya does not use an HMAC shared secret).
TEYA_WEBHOOK_SECRET=""
# Legacy aliases for client id / secret when the modern vars are empty.
TEYA_MERCHANT_ID=""
TEYA_API_KEY=""
PAYMENT_PROVIDER="teya"

# -----------------------------------------------------------------------------
# Web Push (optional). Sound + phone notifications work while the site is open
# without these. Set all three so a notification can arrive when the app is
# closed. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL you control. Do not invent one.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Optional messaging / email / SMS
# In-app chat uses Postgres + polling. Read state is stored on each message (unread until that side opens the thread).
# WhatsApp delivery uses CompanySettings.whatsappE164. The default is +3548353111.
# Other contact fields stay empty. Do not invent them.
# Without the Cloud API vars below, each customer message still creates a staff notification
# and a wa.me link (booking reference and a short notice only — not the private message).
# These vars send that same notice. They do not sync WhatsApp chats into the inbox.
# WHATSAPP_NOTIFY_E164 is optional. When empty, the notice is sent to the company number.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_NOTIFY_E164=""
WHATSAPP_API_VERSION="v21.0"
# SMTP connection string, for example smtp://user:password@smtp.example.com:587
# or smtps://user:password@smtp.example.com:465
# Bookings still save when this is empty. No email is sent, and the reason is stored.
SMTP_URL=""
# From address for those emails. Use an address your mail host is allowed to send as.
MAIL_FROM=""
# Protects GET /api/cron/reminders. Vercel Cron sends this as Authorization: Bearer.
# The job runs hourly. Admin edits the reminder times under System settings.
CRON_SECRET=""
SMS_API_KEY=""

# Demo auth hints (no secrets — cookies only)
# Driver: POST /api/driver/auth { "email": "ari.driver@example.local" }
# Staff inbox: POST /api/auth/demo { "role": "staff" }
# Guest chat: POST /api/auth/demo { "role": "guest", "email": "emma@example.local" }

# Supabase Auth (public identifiers; safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server only: needed only to provision Supabase Auth accounts administratively.
SUPABASE_SECRET_KEY=""

# Independent server-only signing key for guest booking access cookies (at least 32 random bytes).
BOOKING_ACCESS_SECRET=""

# Server-side admin image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
