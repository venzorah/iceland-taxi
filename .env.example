# PostgreSQL (required for live booking/admin/payments persistence)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/iceland_taxi?schema=public"

# Public site URL (payment return URLs, absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps — Places autocomplete / geocode degrade clearly when unset
GOOGLE_MAPS_API_KEY=""

# -----------------------------------------------------------------------------
# Teya Online Payments (https://teya.com/is · hosted checkout)
# Docs: https://docs.teya.com/online-payments/hosted-checkout/get-started
# Never store card numbers — customers pay on Teya-hosted session_url.
# -----------------------------------------------------------------------------
# OAuth client credentials from Teya Business Portal → Integrations
TEYA_CLIENT_ID=""
TEYA_CLIENT_SECRET=""
# Store UUID from the same Integrations screen
TEYA_STORE_ID=""
# sandbox → api.teya.xyz / id.teya.xyz · production → api.teya.com / id.teya.com
TEYA_ENVIRONMENT="sandbox"
# Optional HMAC secret for POST /api/payments/webhook/teya
TEYA_WEBHOOK_SECRET=""
# Legacy aliases (still accepted if modern vars empty)
TEYA_MERCHANT_ID=""
TEYA_API_KEY=""
PAYMENT_PROVIDER="teya"

# Optional messaging / email / SMS (not WhatsApp Business API)
# In-app chat uses Postgres + polling. WhatsApp deep links use CompanySettings.whatsappE164
# from Admin CMS (PATCH /api/admin/company) — leave unset rather than inventing a number.
SMTP_URL=""
SMS_API_KEY=""

# Demo auth hints (no secrets — cookies only)
# Driver: POST /api/driver/auth { "email": "ari.driver@example.local" }
# Staff inbox: POST /api/auth/demo { "role": "staff" }
# Guest chat: POST /api/auth/demo { "role": "guest", "email": "emma@example.local" }
